    whatsapp_sent: number;
    screenshot: number;
    download: number;
    telegram: number;
    other: number;
};

type UploadPeriods = {
    today: number;
    this_week: number;
    this_month: number;
    this_year: number;
};

type DashboardStats = {
    user_count: number;
    total_media_count: number;
    photo_count: number;
    video_count: number;
    source_stats: SourceStats;
    upload_periods: UploadPeriods;
