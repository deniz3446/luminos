                                : "-"
                        }
                    />

                    <InfoItem
                        label="Aktif ağ kartları"
                        value={
                            activeNetworkInterfaces
                                .map(
                                    (item) =>
                                        item.interface
                                )
                                .join(", ") || "-"
                        }
                    />

                    <InfoItem
                        label="Toplam RAM"
                        value={
                            systemMetrics
                                ? formatBytes(
                                      systemMetrics
                                          .memory
                                          .total_bytes
                                  )
                                : "-"
                        }
                    />
                </div>
            </section>

            <section className="panel">
                <div className="panel-header">
                    <div>
                        <h2>Medya Kaynakları</h2>
                        <p>
                            Telefonlardan gelen medya
                            dağılımı
                        </p>
                    </div>
                </div>

                <div className="stats-grid">
                    <StatCard
                        title="Kamera"
                        value={
                            sourceStats?.camera ?? 0
                        }
                        icon="📷"
                    />

                    <StatCard
                        title="WhatsApp Gelen"
                        value={
                            sourceStats
                                ?.whatsapp_received ?? 0
                        }
                        icon="💬"
                    />

                    <StatCard
                        title="WhatsApp Gönderilen"
                        value={
                            sourceStats
                                ?.whatsapp_sent ?? 0
                        }
                        icon="📤"
                    />

                    <StatCard
                        title="Ekran Görüntüleri"
                        value={
                            sourceStats
                                ?.screenshot ?? 0
                        }
                        icon="📱"
                    />

                    <StatCard
                        title="İndirilenler"
                        value={
                            sourceStats?.download ?? 0
                        }
                        icon="📥"
                    />

                    <StatCard
                        title="Telegram"
                        value={
                            sourceStats?.telegram ?? 0
                        }
                        icon="✈️"
                    />

                    <StatCard
                        title="Diğer"
                        value={
                            sourceStats?.other ?? 0
                        }
                        icon="🖼️"
                    />
                </div>
            </section>
        </>
    );
}


function LiveMetricCard({
    title,
    icon,
    value,
    progress,
    subtitle,
    compact = false,
    sparkline,
}: {
    title: string;
    icon: string;
    value: string;
    progress: number;
    subtitle: string;
    compact?: boolean;
    sparkline?: "download" | "upload";
}) {
    const safeProgress = Math.min(
        100,
        Math.max(0, Number(progress) || 0)
    );

    return (
        <article className="live-metric-card">
            <div className="live-metric-title">
                <span className="live-metric-icon">
                    {icon}
                </span>

                <h3>{title}</h3>
            </div>

            <div
                className="live-metric-ring"
                style={{
                    background:
                        `conic-gradient(` +
                        `#ef233c ${safeProgress}%, ` +
                        `#262626 ${safeProgress}% 100%)`,
                }}
            >
                <div className="live-metric-ring-inner">
                    <strong
                        className={
                            compact
                                ? "compact-value"
                                : undefined
                        }
                    >
                        {value}
                    </strong>
                </div>
            </div>

            {sparkline && (
                <div className="metric-sparkline">
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                    <span />
                </div>
            )}

            <p className="live-metric-subtitle">
                {subtitle}
            </p>
        </article>
    );
}

function StatCard({
    title,
    value,
    icon,
    subtitle,
    onClick,
}: {
    title: string;
    value: string | number;
    icon: string;
    subtitle?: string;
    onClick?: () => void;
}) {
    return (
        <div
            className="stat-card"
            onClick={onClick}
            style={{
                cursor: onClick
                    ? "pointer"
                    : "default",
            }}
        >
            <div className="stat-card-icon">
                {icon}
            </div>

            <div>
                <p className="stat-card-title">
                    {title}
                </p>

                <strong className="stat-card-value">
                    {value}
                </strong>

                {subtitle && (
                    <p className="stat-card-subtitle">
                        {subtitle}
                    </p>
                )}
            </div>
        </div>
    );
}

function InfoItem({
    label,
    value,
}: {
    label: string;
    value: string;
}) {
    return (
        <div className="device-info-item">
            <span>{label}</span>
            <strong>{value}</strong>
        </div>
    );
}
