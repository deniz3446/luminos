type NetworkInterfaceMetrics = {
    interface: string;
    received_bytes: number;
    transmitted_bytes: number;
};

type DiskMetrics = {
    name: string;
    model: string;
    size_bytes: number;
    fs_type: string;
    label: string;
    mountpoint: string;
    mounted: boolean;
    used_bytes: number;
    free_bytes: number;
    usage_percent: number;
};

type SystemMetrics = {
    hostname: string;
    operating_system: string;
    kernel_version: string;
    architecture: string;
    cpu_model: string;
    cpu_cores: number;
    cpu_usage_percent: number;
    memory: MemoryMetrics;
    uptime_seconds: number;
    load_average_1m: number;
    load_average_5m: number;
    load_average_15m: number;
    network: NetworkInterfaceMetrics[];
    disks: DiskMetrics[];
};

type SystemHistoryPoint = {
    time: string;
    cpu: number;
    ram: number;
    download: number;
    upload: number;
};

type NetworkSnapshot = Record<
    string,
    {
        receivedBytes: number;
        transmittedBytes: number;
        timestamp: number;
    }
>;

function formatBytes(bytes: number) {
    if (!Number.isFinite(bytes) || bytes <= 0) {
        return "0 B";
    }

    const kb = bytes / 1024;
    const mb = kb / 1024;
    const gb = mb / 1024;
    const tb = gb / 1024;

    if (tb >= 1) {
        return `${tb.toLocaleString("tr-TR", {
            maximumFractionDigits: 2,
        })} TB`;
    }

    if (gb >= 1) {
        return `${gb.toLocaleString("tr-TR", {
            maximumFractionDigits: 2,
        })} GB`;
    }

    if (mb >= 1) {
        return `${mb.toLocaleString("tr-TR", {
            maximumFractionDigits: 2,
        })} MB`;
    }

    return `${kb.toLocaleString("tr-TR", {
        maximumFractionDigits: 2,
    })} KB`;
}

function formatRate(bytesPerSecond: number) {
    if (!Number.isFinite(bytesPerSecond) || bytesPerSecond <= 0) {
        return "0 KB/s";
    }

    const kb = bytesPerSecond / 1024;
    const mb = kb / 1024;

    if (mb >= 1) {
        return `${mb.toLocaleString("tr-TR", {
            maximumFractionDigits: 2,
        })} MB/s`;
    }

    return `${kb.toLocaleString("tr-TR", {
        maximumFractionDigits: 1,
    })} KB/s`;
}

function formatUptime(seconds: number) {
    if (!Number.isFinite(seconds) || seconds <= 0) {
        return "0 dakika";
    }

    const days = Math.floor(seconds / 86400);
    const hours = Math.floor((seconds % 86400) / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);

    const parts: string[] = [];

    if (days > 0) {
        parts.push(`${days} gün`);
    }

    if (hours > 0) {
        parts.push(`${hours} saat`);
    }

    parts.push(`${minutes} dakika`);

    return parts.join(" ");
}

export default function DashboardPage() {
    const navigate = useNavigate();

    const [stats, setStats] =
        useState<DashboardStats | null>(null);

    const [storage, setStorage] =
        useState<StorageInfo | null>(null);

    const [systemMetrics, setSystemMetrics] =
        useState<SystemMetrics | null>(null);

    const [systemHistory, setSystemHistory] =
        useState<SystemHistoryPoint[]>([]);

    const [downloadRate, setDownloadRate] =
        useState(0);

    const [uploadRate, setUploadRate] =
        useState(0);

    const [lastUpdated, setLastUpdated] =
        useState("");

    const [error, setError] =
        useState("");

    const networkSnapshotRef =
        useRef<NetworkSnapshot>({});

    async function loadDashboard() {
        try {
            const timestamp = Date.now();

            const [statsRes, storageRes] =
                await Promise.all([
                    api(
                        `/api/v1/dashboard/stats?ts=${timestamp}`
                    ),
                    api(
                        `/api/v1/storage?ts=${timestamp}`
                    ),
                ]);

            if (!statsRes.ok) {
                throw new Error(
                    `Stats alınamadı: ${statsRes.status}`
                );
            }

            if (!storageRes.ok) {
                throw new Error(
                    `Storage alınamadı: ${storageRes.status}`
                );
            }

            const statsData =
                await statsRes.json();

            const storageData =
                await storageRes.json();

            setStats(statsData);
            setStorage(storageData);
        } catch (err) {
            console.error(
                "Dashboard verileri alınamadı:",
                err
            );

            setError(
                "Dashboard verileri alınamadı."
            );
        }
    }

    async function loadSystemMetrics() {
        try {
            const timestamp = Date.now();

            const response = await api(
                `/api/v1/dashboard/system-metrics?ts=${timestamp}`
            );

            if (!response.ok) {
                throw new Error(
                    `Sistem metrikleri alınamadı: ${response.status}`
                );
            }

            const metrics: SystemMetrics =
                await response.json();

            const now = Date.now();

            let totalDownloadRate = 0;
            let totalUploadRate = 0;

            const nextSnapshot: NetworkSnapshot = {};

            for (const network of metrics.network) {
                const previous =
                    networkSnapshotRef.current[
                        network.interface
                    ];

                nextSnapshot[network.interface] = {
                    receivedBytes:
                        network.received_bytes,
                    transmittedBytes:
                        network.transmitted_bytes,
                    timestamp: now,
                };

                if (!previous) {
                    continue;
                }

                const elapsedSeconds =
                    (now - previous.timestamp) / 1000;

                if (elapsedSeconds <= 0) {
                    continue;
                }

                const receivedDelta = Math.max(
                    0,
                    network.received_bytes -
                        previous.receivedBytes
                );

                const transmittedDelta = Math.max(
                    0,
                    network.transmitted_bytes -
                        previous.transmittedBytes
                );

                totalDownloadRate +=
                    receivedDelta / elapsedSeconds;

                totalUploadRate +=
                    transmittedDelta / elapsedSeconds;
            }

            networkSnapshotRef.current =
                nextSnapshot;

            setDownloadRate(totalDownloadRate);
            setUploadRate(totalUploadRate);
            setSystemMetrics(metrics);

            const point: SystemHistoryPoint = {
                time: new Date().toLocaleTimeString(
                    "tr-TR",
                    {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                    }
                ),
                cpu: Number(
                    metrics.cpu_usage_percent.toFixed(1)
                ),
                ram: Number(
                    metrics.memory.usage_percent.toFixed(1)
                ),
                download: Number(
                    (totalDownloadRate / 1024).toFixed(1)
                ),
                upload: Number(
                    (totalUploadRate / 1024).toFixed(1)
                ),
            };

            setSystemHistory((current) => {
                const next = [...current, point];

                return next.slice(-30);
            });

            setLastUpdated(
                new Date().toLocaleTimeString(
                    "tr-TR"
                )
            );

            setError("");
        } catch (err) {
            console.error(
                "Sistem metrikleri alınamadı:",
                err
            );

            setError(
                "Sistem metrikleri alınamadı."
            );
        }
    }

    useEffect(() => {
        loadDashboard();
        loadSystemMetrics();

        const dashboardTimer =
            window.setInterval(
                loadDashboard,
                10000
            );

        const systemTimer =
            window.setInterval(
                loadSystemMetrics,
                2000
            );

        return () => {
            window.clearInterval(
                dashboardTimer
            );

            window.clearInterval(
                systemTimer
            );
        };
    }, []);

    const sourceStats = stats?.source_stats;

    const activeNetworkInterfaces = useMemo(
        () =>
            systemMetrics?.network.filter(
                (item) =>
                    item.received_bytes > 0 ||
                    item.transmitted_bytes > 0
            ) ?? [],
        [systemMetrics]
    );

    return (
        <>
            <div className="page-title">
                <h1>Dashboard</h1>

                <p>
                    PhotoOS Yönetim Paneli · v
                    {stats?.version ?? "1.0.0"}
                </p>

                {lastUpdated && (
                    <p>
                        Son güncelleme: {lastUpdated}
                    </p>
                )}

                {error && (
                    <p style={{ color: "#ef4444" }}>
                        {error}
                    </p>
                )}
            </div>

            <div className="stats-grid">
                <StatCard
                    title="Kullanıcılar"
                    value={stats?.user_count ?? 0}
                    icon="👥"
                />

                <StatCard
                    title="Toplam Medya"
                    value={
                        stats?.total_media_count ?? 0
