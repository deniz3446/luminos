                />

                <StatCard
                    title="Fotoğraflar"
                    value={stats?.photo_count ?? 0}
                    icon="📷"
                />

                <StatCard
                    title="Videolar"
                    value={stats?.video_count ?? 0}
                    icon="🎥"
                />

                <StatCard
                    title="Depolama"
                    value={
                        storage
                            ? formatBytes(
                                  storage.used_bytes
                              )
                            : "0 B"
                    }
                    icon="💾"
                    subtitle={
                        storage
                            ? `%${Number(
                                  storage.usage_percent ?? 0
                              ).toLocaleString(
                                  "tr-TR",
                                  {
                                      maximumFractionDigits: 2,
                                  }
                              )} kullanılıyor`
                            : undefined
                    }
                />
            </div>

            <section className="panel">
                <div className="panel-header">
                    <div>
                        <h2>Canlı Sistem Durumu</h2>
                        <p>
                            CPU, RAM ve ağ trafiği
                        </p>
                    </div>
                </div>

                <div className="live-metrics-grid">
                    <LiveMetricCard
                        title="CPU Kullanımı"
                        icon="⚙"
                        value={`%${(
                            systemMetrics
                                ?.cpu_usage_percent ?? 0
                        ).toLocaleString("tr-TR", {
                            maximumFractionDigits: 1,
                        })}`}
                        progress={
                            systemMetrics
                                ?.cpu_usage_percent ?? 0
                        }
                        subtitle={
                            systemMetrics
                                ? `${systemMetrics.cpu_cores} mantıksal çekirdek`
                                : "-"
                        }
                    />

                    <LiveMetricCard
                        title="RAM Kullanımı"
                        icon="▦"
                        value={`%${(
                            systemMetrics
                                ?.memory
                                .usage_percent ?? 0
                        ).toLocaleString("tr-TR", {
                            maximumFractionDigits: 1,
                        })}`}
                        progress={
                            systemMetrics
                                ?.memory
                                .usage_percent ?? 0
                        }
                        subtitle={
                            systemMetrics
                                ? `${formatBytes(
                                      systemMetrics.memory.used_bytes
                                  )} / ${formatBytes(
                                      systemMetrics.memory.total_bytes
                                  )}`
                                : "-"
                        }
                    />

                    <LiveMetricCard
                        title="Ağ İndirme"
                        icon="↓"
                        value={formatRate(downloadRate)}
                        progress={Math.min(
                            100,
                            downloadRate / 1024 / 10
                        )}
                        subtitle="Anlık indirme hızı"
                        sparkline="download"
                    />

                    <LiveMetricCard
                        title="Ağ Yükleme"
                        icon="↑"
                        value={formatRate(uploadRate)}
                        progress={Math.min(
                            100,
                            uploadRate / 1024 / 10
                        )}
                        subtitle="Anlık yükleme hızı"
                        sparkline="upload"
                    />

                    <LiveMetricCard
                        title="Çalışma Süresi"
                        icon="◷"
                        value={formatUptime(
                            systemMetrics
                                ?.uptime_seconds ?? 0
                        )}
                        progress={100}
                        subtitle="Sunucu kesintisiz çalışma"
                        compact
                    />
                </div>

                <div
                    style={{
                        display: "grid",
                        gridTemplateColumns:
                            "repeat(auto-fit, minmax(320px, 1fr))",
                        gap: "20px",
                        marginTop: "20px",
                    }}
                >
                    <div className="dashboard-chart-card">
                        <h3>CPU ve RAM</h3>

                        <div
                            style={{
                                width: "100%",
                                height: "280px",
                            }}
                        >
                            <ResponsiveContainer>
                                <LineChart
                                    data={systemHistory}
                                >
                                    <CartesianGrid
                                        strokeDasharray="3 3"
                                    />
                                    <XAxis
                                        dataKey="time"
                                        minTickGap={24}
                                    />
                                    <YAxis
                                        domain={[0, 100]}
                                        unit="%"
                                    />
                                    <Tooltip />
                                    <Legend />
                                    <Line
                                        type="monotone"
                                        dataKey="cpu"
                                        name="CPU"
                                        stroke="#3b82f6"
                                        dot={false}
                                        isAnimationActive={false}
                                    />
                                    <Line
                                        type="monotone"
                                        dataKey="ram"
                                        name="RAM"
                                        stroke="#22c55e"
                                        dot={false}
                                        isAnimationActive={false}
                                    />
                                </LineChart>
                            </ResponsiveContainer>
                        </div>
                    </div>

                    <div className="dashboard-chart-card">
                        <h3>Ağ Trafiği</h3>

                        <div
                            style={{
                                width: "100%",
                                height: "280px",
                            }}
                        >
                            <ResponsiveContainer>
                                <LineChart
                                    data={systemHistory}
                                >
                                    <CartesianGrid
                                        strokeDasharray="3 3"
                                    />
                                    <XAxis
                                        dataKey="time"
                                        minTickGap={24}
                                    />
                                    <YAxis
                                        unit=" KB/s"
                                    />
                                    <Tooltip />
                                    <Legend />
                                    <Line
                                        type="monotone"
                                        dataKey="download"
                                        name="İndirme"
                                        stroke="#8b5cf6"
                                        dot={false}
                                        isAnimationActive={false}
                                    />
                                    <Line
                                        type="monotone"
                                        dataKey="upload"
                                        name="Yükleme"
                                        stroke="#f59e0b"
                                        dot={false}
                                        isAnimationActive={false}
                                    />
                                </LineChart>
                            </ResponsiveContainer>
                        </div>
                    </div>
                </div>
            </section>

            <section className="panel disk-panel">
                <div className="panel-header">
                    <div>
                        <h2>Diskler</h2>
                        <p>
                            Fiziksel diskler ve kullanım durumları
                        </p>
                    </div>

                    <div className="disk-total-badge">
                        {systemMetrics?.disks.length ?? 0} disk
                    </div>
                </div>

                <div className="disk-grid">
                    {(systemMetrics?.disks ?? []).map(
                        (disk) => {
                            const usage = Math.min(
                                100,
                                Math.max(
                                    0,
                                    Number(
                                        disk.usage_percent ?? 0
                                    )
                                )
                            );

                            return (
                                <article
                                    className="disk-card"
                                    key={disk.name}
                                >
                                    <div className="disk-card-header">
                                        <div>
                                            <span className="disk-name">
                                                Disk {disk.name}
                                            </span>

                                            <strong>
                                                {formatBytes(
                                                    disk.size_bytes
                                                )}
                                            </strong>
                                        </div>

                                        <span
                                            className={
                                                disk.mounted
                                                    ? "disk-status mounted"
                                                    : "disk-status unmounted"
                                            }
                                        >
                                            {disk.mounted
                                                ? "Bağlı"
                                                : "Bağlı değil"}
                                        </span>
                                    </div>

                                    <div className="disk-card-body">
                                        <div
                                            className="disk-ring"
                                            style={{
                                                background:
                                                    `conic-gradient(` +
                                                    `#ef233c ${usage}%, ` +
                                                    `#242424 ${usage}% 100%)`,
                                            }}
                                        >
                                            <div className="disk-ring-inner">
                                                <strong>
                                                    %
                                                    {usage.toLocaleString(
                                                        "tr-TR",
                                                        {
                                                            maximumFractionDigits: 1,
                                                        }
                                                    )}
                                                </strong>

                                                <span>
                                                    Kullanılıyor
                                                </span>
                                            </div>
                                        </div>

                                        <div className="disk-details">
                                            <div>
                                                <span>Model</span>
                                                <strong>
                                                    {disk.model}
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Dosya sistemi</span>
                                                <strong>
                                                    {disk.fs_type}
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Etiket</span>
                                                <strong>
                                                    {disk.label || "-"}
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Bağlantı</span>
                                                <strong>
                                                    {disk.mountpoint || "-"}
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Kullanılan</span>
                                                <strong>
                                                    {disk.mounted
                                                        ? formatBytes(
                                                              disk.used_bytes
                                                          )
                                                        : "-"}
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Boş alan</span>
                                                <strong>
                                                    {disk.mounted
                                                        ? formatBytes(
                                                              disk.free_bytes
                                                          )
                                                        : "-"}
                                                </strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div className="disk-progress">
                                        <div
                                            style={{
                                                width: `${usage}%`,
                                            }}
                                        />
                                    </div>
                                </article>
                            );
                        }
                    )}

                    {!systemMetrics?.disks.length && (
                        <div className="disk-empty">
                            Disk bilgisi alınamadı.
                        </div>
                    )}
                </div>
            </section>

            <section className="panel">
                <div className="panel-header">
                    <div>
                        <h2>Cihaz Bilgileri</h2>
                        <p>
                            PhotoOS sunucu donanımı ve
                            işletim sistemi
                        </p>
                    </div>
                </div>

                <div className="device-info-grid">
                    <InfoItem
                        label="Cihaz adı"
                        value={
                            systemMetrics?.hostname ??
                            "-"
                        }
                    />

                    <InfoItem
                        label="İşletim sistemi"
                        value={
                            systemMetrics
                                ?.operating_system ??
                            "-"
                        }
                    />

                    <InfoItem
                        label="İşlemci"
                        value={
                            systemMetrics?.cpu_model ??
                            "-"
                        }
                    />

                    <InfoItem
                        label="Mimari"
                        value={
                            systemMetrics?.architecture ??
                            "-"
                        }
                    />

                    <InfoItem
                        label="Kernel"
                        value={
                            systemMetrics
                                ?.kernel_version ??
                            "-"
                        }
                    />

                    <InfoItem
                        label="Load average"
                        value={
                            systemMetrics
                                ? [
                                      systemMetrics
                                          .load_average_1m,
                                      systemMetrics
                                          .load_average_5m,
                                      systemMetrics
                                          .load_average_15m,
                                  ]
                                      .map((value) =>
                                          value.toLocaleString(
                                              "tr-TR",
                                              {
