        useState<DashboardStats | null>(null);

    const [storage, setStorage] =
        useState<StorageInfo | null>(null);

    const [system, setSystem] =
        useState<SystemMetrics | null>(null);

    const [storageDisks, setStorageDisks] =
        useState<StorageDisksResponse | null>(null);

    const [lastUpdated, setLastUpdated] =
        useState("");

    const [error, setError] =
        useState("");

    const [loading, setLoading] =
        useState(true);

    async function loadDashboard() {
        try {
            const timestamp = Date.now();

            const [
                statsResult,
                storageResult,
                systemResult,
                storageDisksResult,
            ] = await Promise.allSettled([
                api(`/api/v1/dashboard/stats?ts=${timestamp}`),
                api(`/api/v1/storage?ts=${timestamp}`),
                api(`/api/v1/system/metrics?ts=${timestamp}`),
                api(`/api/v1/storage/disks?ts=${timestamp}`),
            ]);

            if (statsResult.status !== "fulfilled") {
                throw new Error("Dashboard istatistiklerine ulaşılamadı.");
            }

            if (!statsResult.value.ok) {
                throw new Error(
                    `Dashboard API hatası: ${statsResult.value.status}`
                );
            }

            const statsData =
                (await statsResult.value.json()) as DashboardStats;

            setStats(statsData);

            if (
                storageResult.status === "fulfilled" &&
                storageResult.value.ok
            ) {
                setStorage(
                    (await storageResult.value.json()) as StorageInfo
                );
            }

            if (
                systemResult.status === "fulfilled" &&
                systemResult.value.ok
            ) {
                setSystem(
                    (await systemResult.value.json()) as SystemMetrics
                );
            }

            if (
                storageDisksResult.status === "fulfilled" &&
                storageDisksResult.value.ok
            ) {
                setStorageDisks(
                    (await storageDisksResult.value.json()) as StorageDisksResponse
                );
            }

            setLastUpdated(
                new Date().toLocaleTimeString("tr-TR", {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                })
            );

            setError("");
        } catch (err) {
            console.error("Dashboard yüklenemedi:", err);

            setError(
                err instanceof Error
                    ? err.message
                    : "Dashboard verileri alınamadı."
            );
        } finally {
            setLoading(false);
        }
    }

    useEffect(() => {
        void loadDashboard();

        const timer = window.setInterval(() => {
            void loadDashboard();
        }, 5000);

        return () => {
            window.clearInterval(timer);
        };
    }, []);

    const sourceData = useMemo(() => {
        const source = stats?.source_stats;

        return [
            {
                name: "Kamera",
                value: source?.camera ?? 0,
            },
            {
                name: "WhatsApp Gelen",
                value: source?.whatsapp_received ?? 0,
            },
            {
                name: "WhatsApp Gönderilen",
                value: source?.whatsapp_sent ?? 0,
            },
            {
                name: "Ekran Görüntüsü",
                value: source?.screenshot ?? 0,
            },
            {
                name: "İndirilenler",
                value: source?.download ?? 0,
            },
            {
                name: "Telegram",
                value: source?.telegram ?? 0,
            },
            {
                name: "Diğer",
                value: source?.other ?? 0,
            },
        ].filter((item) => item.value > 0);
    }, [stats]);

    const uploadChartData = useMemo<ChartPoint[]>(() => {
        const periods = stats?.upload_periods;

        return [
            {
                label: "Bugün",
                value: periods?.today ?? 0,
            },
            {
                label: "7 Gün",
                value: periods?.this_week ?? 0,
            },
            {
                label: "Bu Ay",
                value: periods?.this_month ?? 0,
            },
            {
