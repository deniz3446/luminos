                                                disk.label ||
                                                disk.name}
                                        </strong>

                                        <small>
                                            {formatBytes(
                                                disk.total_bytes
                                            )}{" "}
                                            · {disk.mountpoint || "Bağlı"}
                                        </small>
                                    </div>

                                    <span className="dashboard-disk-state">
                                        {disk.system_disk
                                            ? "Sistem"
                                            : `%${clampPercent(
                                                disk.usage_percent
                                            ).toFixed(0)}`}
                                    </span>
                                </div>
                            ))
                        ) : (
                            <div className="dashboard-empty-inline">
                                Disk metrikleri API’den bekleniyor.
                            </div>
                        )}
                    </div>
                </article>

                <article className="dashboard-panel dashboard-ai-panel">
                    <div className="dashboard-ai-orb">✦</div>

                    <span className="dashboard-panel-kicker">
                        Yakında
                    </span>

                    <h2>PhotoOS AI</h2>

                    <p>
                        Fotoğraflarda kişi, yer ve nesne arama;
                        otomatik albümler ve akıllı öneriler.
                    </p>

                    <button type="button" disabled>
                        Hazırlanıyor
                    </button>
                </article>
            </section>

            <footer className="dashboard-footer">
                <span>
                    PhotoOS v{stats?.version || "1.0.0"}
                </span>

                <span>
                    {loading
                        ? "Dashboard yükleniyor..."
                        : `Son güncelleme ${lastUpdated || "—"}`}
                </span>
            </footer>
        </div>
    );
}
