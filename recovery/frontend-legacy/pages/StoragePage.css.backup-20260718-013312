.storage-manager {
    color: #f4f4f5;
}

.storage-manager-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background:
        radial-gradient(
            circle at 85% 0%,
            rgba(59, 130, 246, 0.18),
            transparent 38%
        ),
        linear-gradient(145deg, #111114, #09090b);
}

.storage-manager-kicker,
.storage-panel-heading span {
    color: #fb7185;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.storage-manager-hero h1 {
    margin: 8px 0 5px;
    font-size: 38px;
}

.storage-manager-hero p {
    margin: 0;
    color: #a1a1aa;
}

.storage-manager-hero-actions {
    display: flex;
    gap: 10px;
}

.storage-manager-status {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.28);
}

.storage-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
}

.storage-manager-status div {
    display: grid;
}

.storage-manager-status small {
    color: #71717a;
    font-size: 9px;
}

.storage-manager-status strong {
    font-size: 12px;
}

.storage-manager-hero-actions button {
    padding: 0 16px;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 14px;
    color: white;
    background: rgba(59, 130, 246, 0.12);
    cursor: pointer;
}

.storage-summary-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
}

.storage-summary-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: linear-gradient(145deg, #101013, #09090b);
}

.storage-summary-icon {
    display: grid;
    width: 43px;
    height: 43px;
    place-items: center;
    border-radius: 13px;
    background: rgba(59, 130, 246, 0.13);
    font-size: 21px;
}

.storage-summary-card div {
    display: grid;
    min-width: 0;
}

.storage-summary-card small {
    color: #a1a1aa;
    font-size: 10px;
}

.storage-summary-card strong {
    margin: 3px 0;
    font-size: 19px;
}

.storage-summary-card div span {
    overflow: hidden;
    color: #71717a;
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.storage-manager-panel {
    margin-bottom: 18px;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 21px;
    background: linear-gradient(145deg, #0f0f12, #09090b);
}

.storage-panel-heading {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 17px;
}

.storage-panel-heading h2 {
    margin: 5px 0 0;
    font-size: 20px;
}

.storage-panel-count,
.raid-badge {
    align-self: flex-start;
    padding: 6px 10px;
    border: 1px solid rgba(34, 197, 94, 0.22);
    border-radius: 999px;
    color: #86efac;
    font-size: 10px;
}

.storage-disk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.storage-disk-card {
    padding: 17px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
}

.storage-disk-head {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
}

.storage-disk-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 13px;
    background: rgba(59, 130, 246, 0.13);
    font-size: 22px;
}

.storage-disk-title {
    min-width: 0;
}

.storage-disk-title h3,
.storage-disk-title p {
    overflow: hidden;
    margin: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.storage-disk-title p {
    margin-top: 4px;
    color: #71717a;
    font-size: 10px;
}

.storage-health-badge {
    padding: 6px 9px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
}

.storage-health-badge.healthy {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.1);
}

.storage-health-badge.warning {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.1);
}

.storage-health-badge.danger {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.1);
}

.storage-disk-capacity,
.storage-smart-grid,
.storage-disk-footer {
    display: grid;
    gap: 9px;
}

.storage-disk-capacity {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 18px;
}

.storage-smart-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 15px;
}

.storage-disk-footer {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 14px;
}

.storage-disk-capacity > div,
.storage-smart-grid > div,
.storage-disk-footer > div {
    display: grid;
    min-width: 0;
    padding: 10px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.025);
}

.storage-disk-capacity small,
.storage-smart-grid small,
.storage-disk-footer small {
    color: #71717a;
    font-size: 8px;
}

.storage-disk-capacity strong {
    margin-top: 4px;
    font-size: 19px;
}

.storage-smart-grid strong,
.storage-disk-footer strong {
    overflow: hidden;
    margin-top: 3px;
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.storage-usage-heading {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    color: #a1a1aa;
    font-size: 10px;
}

.storage-usage-track {
    overflow: hidden;
    height: 7px;
    margin-top: 8px;
    border-radius: 999px;
    background: #27272a;
}

.storage-usage-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #2563eb, #60a5fa);
}

.metric-warning {
    color: #fbbf24;
}

.storage-warning-box {
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 12px;
    color: #fde68a;
    background: rgba(245, 158, 11, 0.07);
    font-size: 9px;
}

.storage-bottom-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}

.storage-system-list > div,
.storage-raid-card,
.storage-check-list > div {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.02);
}

.storage-system-list div div,
.storage-check-list div div {
    display: grid;
    min-width: 0;
    flex: 1;
}

.storage-system-list small,
.storage-check-list small,
.storage-raid-card p {
    margin-top: 3px;
    color: #71717a;
    font-size: 9px;
}

.storage-check-list {
    display: grid;
    gap: 9px;
}

.storage-check-list > div > span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 10px;
    color: #86efac;
    background: rgba(34, 197, 94, 0.1);
}

.storage-readonly-note {
    margin-top: 12px;
    padding: 10px;
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: #71717a;
    font-size: 9px;
}

.storage-loading,
.storage-empty-state {
    display: grid;
    min-height: 240px;
    place-content: center;
    color: #71717a;
    text-align: center;
}

@media (max-width: 1350px) {
    .storage-summary-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 1050px) {
    .storage-bottom-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 850px) {
    .storage-manager-hero,
    .storage-disk-grid {
        grid-template-columns: 1fr;
    }

    .storage-manager-hero {
        flex-direction: column;
    }

    .storage-summary-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .storage-smart-grid,
    .storage-disk-footer,
    .storage-disk-capacity {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* PHOTOOS_SMART_TEST_UI_V1 */

.storage-smart-test-box {
    display: grid;
    gap: 11px;
    margin-top: 14px;
    padding: 13px;
    border: 1px solid rgba(96, 165, 250, 0.18);
    border-radius: 14px;
    background: rgba(37, 99, 235, 0.055);
}

.storage-smart-test-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.storage-smart-test-head > div {
    display: grid;
    gap: 3px;
    min-width: 0;
}

.storage-smart-test-head small {
    color: #71717a;
    font-size: 9px;
}

.storage-smart-test-head strong {
    font-size: 12px;
}

.storage-smart-test-badge {
    flex-shrink: 0;
    padding: 6px 9px;
    border-radius: 999px;
    color: #a1a1aa;
    background: rgba(161, 161, 170, 0.1);
    font-size: 8px;
    font-weight: 900;
}

.storage-smart-test-badge.running {
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.14);
}

.storage-smart-test-badge.passed {
    color: #86efac;
    background: rgba(34, 197, 94, 0.12);
}

.storage-smart-test-badge.failed {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.12);
}

.storage-smart-test-progress {
    overflow: hidden;
    height: 7px;
    border-radius: 999px;
    background: rgba(39, 39, 42, 0.95);
}

.storage-smart-test-progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #2563eb, #60a5fa);
    transition: width 0.35s ease;
}

.storage-smart-test-message {
    display: grid;
    gap: 4px;
    color: #a1a1aa;
    font-size: 9px;
    line-height: 1.45;
}

.storage-smart-test-message small {
    color: #71717a;
    font-size: 8px;
}

.smart-test-error {
    color: #fca5a5;
}

.storage-smart-test-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
}

.storage-smart-test-actions button {
    min-height: 36px;
    padding: 8px 10px;
    border: 1px solid rgba(96, 165, 250, 0.28);
    border-radius: 10px;
    color: #dbeafe;
    background: rgba(37, 99, 235, 0.16);
    cursor: pointer;
    font-size: 9px;
    font-weight: 800;
}

.storage-smart-test-actions button:hover:not(:disabled) {
    background: rgba(37, 99, 235, 0.25);
}

.storage-smart-test-actions button.secondary {
    border-color: rgba(255, 255, 255, 0.1);
    color: #d4d4d8;
    background: rgba(255, 255, 255, 0.035);
}

.storage-smart-test-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
}

@media (max-width: 600px) {
    .storage-smart-test-actions {
        grid-template-columns: 1fr;
    }

    .storage-smart-test-head {
        align-items: flex-start;
        flex-direction: column;
    }
}



/* PHOTOOS_STORAGE_METRICS_UI_V1 */
.storage-metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.storage-metric-card {
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
}

.storage-metric-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.storage-metric-card-head > div { display: grid; gap: 3px; }
.storage-metric-card-head small { color: #71717a; font-size: 9px; }
.storage-metric-card-head strong { font-size: 13px; }
.storage-metric-card-head b { font-size: 22px; }

.storage-temperature-chart {
    width: 100%;
    height: 86px;
    margin-top: 14px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.055);
}

.storage-temperature-chart polyline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    vector-effect: non-scaling-stroke;
}

.storage-io-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
}

.storage-io-grid > div {
    display: grid;
    min-width: 0;
    padding: 9px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.025);
}

.storage-io-grid small { color: #71717a; font-size: 8px; }
.storage-io-grid strong { margin-top: 4px; font-size: 10px; overflow: hidden; text-overflow: ellipsis; }

@media (max-width: 850px) {
    .storage-metrics-grid { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
    .storage-io-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
