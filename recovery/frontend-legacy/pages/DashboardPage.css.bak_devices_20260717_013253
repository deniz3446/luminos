.dashboard-v2 {
    --dashboard-bg: #070708;
    --dashboard-panel: #0e0e11;
    --dashboard-panel-soft: #131318;
    --dashboard-border: rgba(255, 255, 255, 0.075);
    --dashboard-red: #e11d48;
    --dashboard-red-light: #fb7185;
    --dashboard-text: #fafafa;
    --dashboard-muted: #a1a1aa;

    min-height: 100%;
    color: var(--dashboard-text);
}

.dashboard-v2 button {
    font: inherit;
}

.dashboard-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
    padding: 28px;
    border: 1px solid var(--dashboard-border);
    border-radius: 26px;
    background:
        radial-gradient(
            circle at 80% 0%,
            rgba(225, 29, 72, 0.18),
            transparent 38%
        ),
        linear-gradient(145deg, #111114, #080809);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
}

.dashboard-eyebrow,
.dashboard-panel-kicker {
    color: var(--dashboard-red-light);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.dashboard-live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.1);
}

.dashboard-hero h1 {
    margin: 10px 0 6px;
    font-size: clamp(30px, 4vw, 46px);
    letter-spacing: -0.04em;
}

.dashboard-hero p {
    margin: 0;
    color: var(--dashboard-muted);
    font-size: 15px;
}

.dashboard-hero-actions {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
}

.dashboard-server-pill {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 150px;
    padding: 11px 14px;
    border: 1px solid var(--dashboard-border);
    border-radius: 15px;
    background: rgba(8, 8, 10, 0.72);
}

.dashboard-server-pill > span {
    font-size: 21px;
}

.dashboard-server-pill div {
    display: grid;
    gap: 3px;
}

.dashboard-server-pill small {
    color: #71717a;
    font-size: 11px;
}

.dashboard-server-pill strong {
    font-size: 13px;
}

.dashboard-refresh-button,
.dashboard-link-button {
    border: 1px solid rgba(225, 29, 72, 0.35);
    border-radius: 14px;
    color: #fff;
    background: rgba(225, 29, 72, 0.12);
    cursor: pointer;
    font-weight: 800;
}

.dashboard-refresh-button {
    padding: 0 18px;
}

.dashboard-link-button {
    padding: 9px 12px;
}

.dashboard-refresh-button:hover,
.dashboard-link-button:hover {
    background: rgba(225, 29, 72, 0.24);
}

.dashboard-error {
    margin-bottom: 20px;
    padding: 14px 17px;
    border: 1px solid rgba(239, 68, 68, 0.32);
    border-radius: 15px;
    background: rgba(127, 29, 29, 0.2);
    color: #fecaca;
}

.dashboard-stat-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 15px;
    margin-bottom: 20px;
}

.dashboard-stat-card {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 19px;
    border: 1px solid var(--dashboard-border);
    border-radius: 20px;
    color: inherit;
    text-align: left;
    background: linear-gradient(145deg, #111114, #09090b);
    transition:
        transform 160ms ease,
        border-color 160ms ease,
        box-shadow 160ms ease;
}

.dashboard-stat-card:not(:disabled) {
    cursor: pointer;
}

.dashboard-stat-card:not(:disabled):hover {
    transform: translateY(-3px);
    border-color: rgba(225, 29, 72, 0.35);
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.26);
}

.dashboard-stat-icon {
    display: grid;
    flex: 0 0 47px;
    width: 47px;
    height: 47px;
    place-items: center;
    border-radius: 15px;
    background: rgba(225, 29, 72, 0.13);
    font-size: 23px;
}

.dashboard-stat-copy {
    display: grid;
    min-width: 0;
}

.dashboard-stat-label {
    color: var(--dashboard-muted);
    font-size: 12px;
}

.dashboard-stat-copy strong {
    margin: 4px 0;
    font-size: 24px;
    line-height: 1;
}

.dashboard-stat-copy small {
    overflow: hidden;
    color: #71717a;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dashboard-main-grid,
.dashboard-chart-grid,
.dashboard-bottom-grid {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
}

.dashboard-main-grid {
    grid-template-columns: minmax(0, 1.65fr) minmax(310px, 0.85fr);
}

.dashboard-chart-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.dashboard-bottom-grid {
    grid-template-columns: 1.25fr 1fr 0.78fr;
}

.dashboard-panel {
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--dashboard-border);
    border-radius: 22px;
    background: linear-gradient(145deg, #101013, #09090b);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
}

.dashboard-panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 20px;
}

.dashboard-panel-heading h2 {
    margin: 5px 0 0;
    font-size: 20px;
}

.dashboard-status-badge {
    padding: 7px 10px;
    border: 1px solid rgba(34, 197, 94, 0.24);
    border-radius: 999px;
    color: #86efac;
    background: rgba(34, 197, 94, 0.09);
    font-size: 11px;
    font-weight: 800;
}

.dashboard-update-time {
    color: #71717a;
    font-size: 11px;
}

.dashboard-health-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.dashboard-progress-card {
    padding: 16px;
    border: 1px solid var(--dashboard-border);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.022);
}

.dashboard-progress-heading {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.dashboard-progress-heading div {
    display: grid;
    gap: 4px;
}

.dashboard-progress-heading span {
    color: var(--dashboard-muted);
    font-size: 12px;
}

.dashboard-progress-heading strong {
    font-size: 23px;
}

.dashboard-progress-icon {
    font-size: 23px !important;
}

.dashboard-progress-track,
.dashboard-user-track {
    overflow: hidden;
    border-radius: 999px;
    background: #27272a;
}

.dashboard-progress-track {
    height: 7px;
    margin: 15px 0 10px;
}

.dashboard-progress-track span,
.dashboard-user-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #be123c, #fb7185);
}

.dashboard-progress-card small {
    color: #71717a;
    font-size: 11px;
}

.dashboard-system-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 16px;
    border: 1px solid var(--dashboard-border);
    border-radius: 16px;
    background: var(--dashboard-border);
}

.dashboard-system-strip > div {
    display: grid;
    gap: 5px;
    min-width: 0;
    padding: 13px;
    background: #0d0d10;
}

.dashboard-system-strip small {
    color: #71717a;
    font-size: 10px;
}

.dashboard-system-strip strong {
    overflow: hidden;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dashboard-storage-content {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) minmax(140px, 0.85fr);
    align-items: center;
    gap: 10px;
}

.dashboard-donut {
    position: relative;
    min-width: 0;
}

.dashboard-donut-label {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    transform: translate(-50%, -50%);
    text-align: center;
}

.dashboard-donut-label strong {
    font-size: 27px;
}

.dashboard-donut-label span {
    color: #71717a;
    font-size: 10px;
}

.dashboard-storage-values {
    display: grid;
    gap: 15px;
}

.dashboard-storage-values > div {
    display: flex;
    align-items: center;
    gap: 10px;
}

.dashboard-storage-values div div {
    display: grid;
}

.dashboard-storage-values small {
    color: #71717a;
    font-size: 10px;
}

.dashboard-storage-values strong {
    margin-top: 2px;
    font-size: 14px;
}

.storage-marker {
    width: 9px;
    height: 9px;
    border-radius: 50%;
}

.storage-marker-used {
    background: #e11d48;
}

.storage-marker-free {
    background: #52525b;
}

.storage-marker-total {
    background: #f4f4f5;
}

.dashboard-chart-box {
    min-height: 280px;
}

.dashboard-source-layout {
    display: grid;
    grid-template-columns: minmax(180px, 0.95fr) minmax(180px, 1.05fr);
    align-items: center;
}

.dashboard-source-list {
    display: grid;
    gap: 10px;
}

.dashboard-source-list > div {
    display: grid;
    grid-template-columns: 9px 1fr auto;
    align-items: center;
    gap: 9px;
}

.dashboard-source-list > div > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.dashboard-source-list small {
    color: var(--dashboard-muted);
}

.dashboard-source-list strong {
    font-size: 13px;
}

.dashboard-empty-state {
    display: grid;
    min-height: 260px;
    place-content: center;
    text-align: center;
}

.dashboard-empty-state span {
    font-size: 48px;
}

.dashboard-empty-state strong {
    margin-top: 12px;
}

.dashboard-empty-state small {
    max-width: 330px;
    margin-top: 8px;
    color: #71717a;
}

.dashboard-user-list,
.dashboard-disk-list {
    display: grid;
    gap: 12px;
}

.dashboard-user-row {
    display: flex;
    align-items: center;
    gap: 12px;
}

.dashboard-user-avatar {
    display: grid;
    flex: 0 0 39px;
    width: 39px;
    height: 39px;
    place-items: center;
    border: 1px solid rgba(225, 29, 72, 0.25);
    border-radius: 13px;
    color: #fecdd3;
    background: rgba(225, 29, 72, 0.12);
    font-weight: 900;
}

.dashboard-user-data {
    display: grid;
    flex: 1;
    gap: 8px;
}

.dashboard-user-data > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.dashboard-user-data span {
    color: #71717a;
    font-size: 11px;
}

.dashboard-user-track {
    height: 5px;
}

.dashboard-disk-row {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    gap: 11px;
    padding: 12px;
    border: 1px solid var(--dashboard-border);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.02);
}

.dashboard-disk-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 20px;
}

.dashboard-disk-row > div {
    display: grid;
    min-width: 0;
}

.dashboard-disk-row strong,
.dashboard-disk-row small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dashboard-disk-row small {
    margin-top: 3px;
    color: #71717a;
    font-size: 10px;
}

.dashboard-disk-state {
    color: #fda4af;
    font-size: 12px;
    font-weight: 900;
}

.dashboard-ai-panel {
    position: relative;
    overflow: hidden;
    display: flex;
    min-height: 250px;
    flex-direction: column;
    justify-content: flex-end;
    background:
        radial-gradient(
            circle at 75% 20%,
            rgba(225, 29, 72, 0.35),
            transparent 34%
        ),
        linear-gradient(145deg, #17070c, #09090b);
}

.dashboard-ai-panel::before {
    position: absolute;
    inset: 0;
    content: "";
    background-image:
        linear-gradient(
            rgba(255, 255, 255, 0.025) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.025) 1px,
            transparent 1px
        );
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, black, transparent);
}

.dashboard-ai-orb {
    position: relative;
    z-index: 1;
    display: grid;
    width: 55px;
    height: 55px;
    margin-bottom: 28px;
    place-items: center;
    border: 1px solid rgba(251, 113, 133, 0.4);
    border-radius: 18px;
    background: rgba(225, 29, 72, 0.18);
    box-shadow: 0 0 40px rgba(225, 29, 72, 0.3);
    font-size: 28px;
}

.dashboard-ai-panel h2,
.dashboard-ai-panel p,
.dashboard-ai-panel span,
.dashboard-ai-panel button {
    position: relative;
    z-index: 1;
}

.dashboard-ai-panel h2 {
    margin: 7px 0;
}

.dashboard-ai-panel p {
    margin: 0 0 16px;
    color: var(--dashboard-muted);
    font-size: 12px;
    line-height: 1.6;
}

.dashboard-ai-panel button {
    align-self: flex-start;
    padding: 9px 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #a1a1aa;
    background: rgba(255, 255, 255, 0.04);
}

.dashboard-empty-inline {
    padding: 20px;
    border: 1px dashed var(--dashboard-border);
    border-radius: 14px;
    color: #71717a;
    text-align: center;
    font-size: 12px;
}

.dashboard-footer {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 3px 0;
    color: #52525b;
    font-size: 11px;
}

@media (max-width: 1400px) {
    .dashboard-stat-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard-bottom-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-ai-panel {
        grid-column: span 2;
        min-height: 220px;
    }
}

@media (max-width: 1050px) {
    .dashboard-hero {
        flex-direction: column;
    }

    .dashboard-hero-actions {
        justify-content: flex-start;
    }

    .dashboard-main-grid,
    .dashboard-chart-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-health-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 760px) {
    .dashboard-hero {
        padding: 20px;
    }

    .dashboard-stat-grid,
    .dashboard-bottom-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-ai-panel {
        grid-column: auto;
    }

    .dashboard-system-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-storage-content,
    .dashboard-source-layout {
        grid-template-columns: 1fr;
    }

    .dashboard-footer {
        flex-direction: column;
    }
}
