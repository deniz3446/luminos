[Unit]
Description=PhotoOS Storage Core
After=network.target photoos.service photoos-storage-helper.service
Requires=photoos-storage-helper.service

[Service]
Type=simple
User=photoos
Group=photoos

ExecStart=/usr/bin/python3 /usr/local/lib/photoos/photoos-storage-core.py

Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
